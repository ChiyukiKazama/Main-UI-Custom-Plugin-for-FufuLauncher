#include <winver.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MAIN_UI_CUSTOMIZER_FILE_VERSION
 PRODUCTVERSION MAIN_UI_CUSTOMIZER_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MainUICustomizer"
            VALUE "FileVersion", MAIN_UI_CUSTOMIZER_FILE_VERSION_STRING
            VALUE "InternalName", "MainUICustomizer"
            VALUE "OriginalFilename", "MainUICustomizer.dll"
            VALUE "ProductName", "MainUICustomizer"
            VALUE "ProductVersion", MAIN_UI_CUSTOMIZER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
